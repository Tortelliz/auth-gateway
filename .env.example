APP_PORT=your_port
DATABASE_URL="postgresql://your_user:your_password@your_host:your_port/your_db?schema=public"
DB_HOST=your_host
DB_PORT=your_port
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_db
LOG_LEVEL=log_or_debug
PAGINATION_DEFAULT_PAGE_SIZE=10
SESSION_TOKEN_EXPIRES_IN_DAYS=90
PASSWORD_TOKEN_EXPIRES_IN_MINUTES=10
FIRST_ACCESS_TOKEN_EXPIRES_IN_MINUTES=10
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN_MINUTES=10
RESEND_API_KEY=your_key
RESEND_NOTIFIER_EMAIL=your_email
SUPPORT_EMAIL=your_email
DEV_SITE=your_url
DB_SEEDS_RUN=boolean
