// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CompanyEntity {
  id         String                @id @db.Uuid
  cnpj       String                @unique @db.Char(14)
  code       String                @unique @db.VarChar(15)
  name       String                @db.VarChar(100)
  created_at DateTime              @db.Timestamptz()
  updated_at DateTime?             @db.Timestamptz()
  address    CompanyAddressEntity?
  users      UserEntity[]
  roles      RoleEntity[]

  @@index([id, code])
  @@map("company")
}

model CompanyAddressEntity {
  id           String        @id @db.Uuid
  company_id   String        @unique @db.Uuid
  company      CompanyEntity @relation(fields: [company_id], references: [id], onDelete: Cascade)
  cep          String        @db.Char(8)
  street       String        @db.VarChar(150)
  neighborhood String        @db.VarChar(100)
  city         String        @db.VarChar(100)
  state        String        @db.VarChar(50)
  uf           String        @db.Char(2)
  number       String        @db.VarChar(15)
  created_at   DateTime      @db.Timestamptz()
  updated_at   DateTime?     @db.Timestamptz()

  @@index([id, company_id])
  @@map("company_address")
}

model UserEntity {
  id                         String           @id @db.Uuid
  company_id                 String           @db.Uuid
  company                    CompanyEntity    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  email                      String           @unique @db.VarChar(255)
  password                   String           @db.VarChar(255)
  first_name                 String           @db.VarChar(50)
  last_name                  String           @db.VarChar(50)
  active                     Boolean          @db.Boolean
  must_change_password       Boolean          @db.Boolean
  must_email_verification    Boolean          @db.Boolean
  first_access               Boolean          @db.Boolean
  failed_login_attempts      Int              @db.SmallInt
  created_at                 DateTime         @db.Timestamptz()
  updated_at                 DateTime?        @db.Timestamptz()
  first_access_at            DateTime?        @db.Timestamptz()
  last_email_verification_at DateTime?        @db.Timestamptz()
  last_login_at              DateTime?        @db.Timestamptz()
  roles                      UserRoleEntity[]
  sessions                   SessionEntity[]
  tokens                     TokenEntity[]

  @@index([id, email, password])
  @@map("user")
}

model RoleEntity {
  id          String           @id @db.Uuid
  company_id  String           @db.Uuid
  company     CompanyEntity    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  code        String           @unique @db.VarChar(15)
  name        String           @db.VarChar(50)
  description String?          @db.VarChar(255)
  created_at  DateTime         @db.Timestamptz()
  updated_at  DateTime?        @db.Timestamptz()
  user_roles  UserRoleEntity[]

  @@index([id, code])
  @@map("role")
}

model UserRoleEntity {
  id         String     @id @db.Uuid
  user_id    String     @db.Uuid
  role_id    String     @db.Uuid
  user       UserEntity @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       RoleEntity @relation(fields: [role_id], references: [id], onDelete: Cascade)
  created_at DateTime   @db.Timestamptz()
  updated_at DateTime?  @db.Timestamptz()

  @@index([id, user_id, role_id])
  @@map("user_role")
}

model SessionEntity {
  id         String     @id @db.Uuid
  user_id    String     @db.Uuid
  user       UserEntity @relation(fields: [user_id], references: [id], onDelete: Cascade)
  hash_token String     @unique
  revoked    Boolean
  created_at DateTime   @db.Timestamptz()
  expires_at DateTime   @db.Timestamptz()
  revoked_at DateTime?  @db.Timestamptz()

  @@index([id, user_id, hash_token])
  @@map("session")
}

enum Resource {
  forgot_password
  first_access
  email_verification
}

model TokenEntity {
  id         String     @id @db.Uuid
  user_id    String     @db.Uuid
  user       UserEntity @relation(fields: [user_id], references: [id], onDelete: Cascade)
  hash_token String     @unique
  resource   Resource
  revoked    Boolean
  created_at DateTime   @db.Timestamptz()
  expires_at DateTime   @db.Timestamptz()
  revoked_at DateTime?  @db.Timestamptz()

  @@index([id, user_id, resource, hash_token])
  @@map("token")
}
