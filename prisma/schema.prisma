// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id         String          @id @db.Uuid
  cnpj       String          @unique @db.Char(14)
  code       String          @unique @db.VarChar(15)
  name       String          @db.VarChar(100)
  created_at DateTime        @db.Timestamptz()
  updated_at DateTime?       @db.Timestamptz()
  address    CompanyAddress?
  users      User[]

  @@index([id, code])
  @@map("company")
}

model CompanyAddress {
  id           String    @id @db.Uuid
  company_id   String    @unique @db.Uuid
  company      Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  cep          String    @db.Char(8)
  street       String    @db.VarChar(150)
  neighborhood String    @db.VarChar(100)
  city         String    @db.VarChar(100)
  state        String    @db.VarChar(50)
  uf           String    @db.Char(2)
  number       String    @db.VarChar(15)
  created_at   DateTime  @db.Timestamptz()
  updated_at   DateTime? @db.Timestamptz()

  @@index([id, company_id])
  @@map("company_address")
}

model User {
  id                    String     @id @db.Uuid
  company_id            String     @unique @db.Uuid
  company               Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  email                 String     @unique
  password              String     @db.VarChar(255)
  first_name            String     @db.VarChar(50)
  last_name             String     @db.VarChar(50)
  active                Boolean    @db.Boolean
  last_login_at         DateTime?  @db.Timestamptz()
  failed_login_attempts Int        @db.SmallInt
  must_change_password  Boolean    @db.Boolean
  created_at            DateTime   @db.Timestamptz()
  updated_at            DateTime?  @db.Timestamptz()
  roles                 UserRole[]

  @@index([id, email, password])
  @@map("user")
}

model Role {
  id          String     @id @db.Uuid
  code        String     @unique @db.VarChar(15)
  name        String     @db.VarChar(50)
  description String?    @db.VarChar(255)
  created_at  DateTime   @db.Timestamptz()
  updated_at  DateTime?  @db.Timestamptz()
  user_roles  UserRole[]

  @@index([id, code])
  @@map("role")
}

model UserRole {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  user       User      @relation(fields: [user_id], references: [id])
  role       Role      @relation(fields: [role_id], references: [id])
  created_at DateTime  @db.Timestamptz()
  updated_at DateTime? @db.Timestamptz()

  @@index([id, user_id, role_id])
  @@map("user_role")
}
